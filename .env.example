REPOSITORY_URL=https://github.com/example/dns-config.git
REPOSITORY_BRANCH=main
OCTODNS_CONFIG_FILE=config-internal.yaml
POLL_INTERVAL_SECONDS=300
RETRY_INTERVAL_SECONDS=60
COMMAND_TIMEOUT_SECONDS=120
RUN_ONCE=false
RESTART_POLICY=unless-stopped
LOG_LEVEL=INFO

# Required only for private HTTPS repositories.
GIT_USERNAME=x-access-token
GIT_TOKEN=

# Consumed by config-internal.yaml through octoDNS env/... values.
BIND_HOST=bind9
OCTODNS_TSIG_NAME=
OCTODNS_TSIG_SECRET=
